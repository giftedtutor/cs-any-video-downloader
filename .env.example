# Public site URL (used for sitemap, Open Graph, canonicals)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: your self-hosted Cobalt instance (recommended for production)
# https://github.com/imputnet/cobalt
COBALT_API_URL=
COBALT_API_KEY=

# Comma-separated Cobalt community API fallbacks (overrides built-in list)
# COBALT_FALLBACK_URLS=https://cobalt-api.example.com,https://another.example.com

# Optional RapidAPI key for extra provider free tiers (YouTube / multi-platform)
# RAPIDAPI_KEY=

# Optional Google AdSense publisher client ID (e.g. ca-pub-xxxxxxxx)
# NEXT_PUBLIC_ADSENSE_CLIENT=
